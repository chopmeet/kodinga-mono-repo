# Copy to <DEPLOY_PATH>/api.env on the VPS (one per environment) and fill in. Never commit the real file.

# --- Django core ---
DEBUG=False
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"  (no $ in it)
SECRET_KEY=change-me

# Domains Django answers on:
#   api.kodinga.fassane.dev  the api subdomain (VPS nginx -> 127.0.0.1:API_PORT)
#   kodinga.fassane.dev      the front, whose nginx still proxies /api (same-origin fallback)
#   localhost                the container's own health check
ALLOWED_HOSTS=api.kodinga.fassane.dev,kodinga.fassane.dev,localhost
# Admin and forms posted to the api domain over HTTPS
CSRF_TRUSTED_ORIGINS=https://api.kodinga.fassane.dev,https://kodinga.fassane.dev

# The front (kodinga.fassane.dev) calls the api on another domain: only allow that origin
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://kodinga.fassane.dev

# Links in emails (reset password, verification) go to the front; BACKEND_URL is the api
FRONTEND_URL=https://kodinga.fassane.dev
BACKEND_URL=https://api.kodinga.fassane.dev

# --- Database: the `postgres` container of deploy/docker-compose.yaml ---
# Same credentials in both places. Password without special characters (@ : / # ?),
# otherwise it must be URL-encoded in DATABASE_URL.
POSTGRES_DB=kodinga
POSTGRES_USER=kodinga
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://kodinga:change-me@postgres:5432/kodinga

# --- Redis (service `redis` of deploy/docker-compose.yaml) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_CHANNEL_URL=redis://redis:6379/2

# --- Email (SMTP) ---
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Kodinga <no-reply@kodinga.com>

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
