# Copy to <DEPLOY_PATH>/api.env on the VPS (one per environment) and fill in. Never commit the real file.

# --- Django core ---
DEBUG=False
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"  (no $ in it)
SECRET_KEY=change-me
ALLOWED_HOSTS=recette.kodinga.com
CSRF_TRUSTED_ORIGINS=https://recette.kodinga.com
# used in emailed links (reset password, verification)
FRONTEND_URL=https://recette.kodinga.com
BACKEND_URL=https://recette.kodinga.com
# web and api share the domain (nginx proxy): no CORS needed
CORS_ALLOW_ALL_ORIGINS=False

# --- Database ---
# Neon (or any external Postgres):
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# ...or the bundled Postgres (also set COMPOSE_PROFILES=local-db in the GitHub environment):
# DATABASE_URL=postgres://kodinga:change-me@postgres:5432/kodinga
# POSTGRES_DB=kodinga
# POSTGRES_USER=kodinga
# POSTGRES_PASSWORD=change-me

# --- Redis (service `redis` of deploy/docker-compose.yaml) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# --- Email (SMTP) ---
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Kodinga <no-reply@kodinga.com>

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
