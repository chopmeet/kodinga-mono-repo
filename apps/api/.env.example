# Core Django Secrets
SECRET_KEY=kodinga-dev-super-secure-secret-key-32-bytes-minimum-length-hash-2026!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok.app
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok.app,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# App & Environment
APP_NAME=Kodinga
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
SUPPORT_EMAIL=support@kodinga.com

# Database: PostgreSQL of the root docker-compose.yaml (docker compose -p kodinga up -d kodingadb).
# Leave unset to fall back to SQLite.
DATABASE_URL=postgres://kodinga:kodinga@localhost:5432/kodinga

# Redis & Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# SMTP Transactional Emails
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Kodinga <no-reply@kodinga.com>
EMAIL_TIMEOUT=20

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==============================================================================
# UploadThing (File, Image & Document Storage - v7+ Token)
# ==============================================================================
# v7 single token containing base64 encoded API Key, App ID & Region
UPLOADTHING_TOKEN=
# Legacy fallback (v6 and below)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# Mux Video on Demand (VOD) & Live Streaming (Direct Uploads & Webhooks)
# ==============================================================================
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# ==============================================================================
# PayDunya Gateway (Online Payments, Mobile Money & Cards - Sandbox & Live)
# ==============================================================================
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=

PAYDUNYA_CALLBACK_URL=http://localhost:8000/api/v1/billing/paydunya/ipn/
PAYDUNYA_SUCCESS_URL=http://localhost:3000/payment/success
PAYDUNYA_CANCEL_URL=http://localhost:3000/payment/cancel


