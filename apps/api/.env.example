# Core Django Secrets
SECRET_KEY=kodinga-dev-super-secure-secret-key-32-bytes-minimum-length-hash-2026!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok.app
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok.app,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# App & Environment
APP_NAME=Kodinga
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
SUPPORT_EMAIL=support@kodinga.com

# Database: PostgreSQL of the root docker-compose.yaml (docker compose -p kodinga up -d kodingadb).
# Leave unset to fall back to SQLite.
DATABASE_URL=postgres://kodinga:kodinga@localhost:5432/kodinga

# Redis & Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# Resend Transactional Emails (Recommended for Production & Staging)
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=no-reply@yourdomain.com
DEFAULT_FROM_EMAIL=Kodinga <no-reply@yourdomain.com>
# Optional backend override (defaults to ResendEmailBackend when RESEND_API_KEY is present)
EMAIL_BACKEND=common.services.email_service.ResendEmailBackend

# Legacy SMTP Configuration (Fallback if Resend is not used)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/google/callback,http://localhost:3000/auth/github/callback

# ==============================================================================
# UploadThing (File, Image & Document Storage - v7+ Token)
# ==============================================================================
# v7 single token containing base64 encoded API Key, App ID & Region
UPLOADTHING_TOKEN=
# Legacy fallback (v6 and below)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=
DATA_UPLOAD_MAX_MEMORY_SIZE=524288000
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
BANNER_MAX_FILE_SIZE_BYTES=10485760
VIDEO_MAX_FILE_SIZE_BYTES=524288000

# Mux Video on Demand (VOD) & Live Streaming (Direct Uploads & Webhooks)
# ==============================================================================
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# ==============================================================================
# PayDunya Gateway (Online Payments, Mobile Money & Cards - Sandbox & Live)
# ==============================================================================
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=

PAYDUNYA_CALLBACK_URL=http://localhost:8000/api/v1/billing/paydunya/ipn/
PAYDUNYA_SUCCESS_URL=http://localhost:3000/payment/success
PAYDUNYA_CANCEL_URL=http://localhost:3000/payment/cancel
KODINGA_PRO_MONTHLY_PRICE=5000.00

# ==============================================================================
# AI Provider Configuration (Google Gemini Primary with OpenAI Fallback)
# ==============================================================================
# Primary provider: Google Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Fallback provider: OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest

# AI routing
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai
AI_FALLBACK_ENABLED=true
AI_PROVIDER_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
