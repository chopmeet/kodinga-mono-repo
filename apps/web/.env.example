# Copy to .env.local to override locally (Vite loads it automatically).
# Public origin of the site, used for absolute URLs in index.html (og:image, og:url).
VITE_SITE_URL=https://kodinga.com
# Optional: api origin if it is not served on the same domain under /api/v1/
# VITE_API_URL=https://api.kodinga.com/api/v1/
